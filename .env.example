# NexusFi environment (apps/frontend). Copy to apps/frontend/.env.local; never commit it.
# Everything runs in the Next.js app: pages plus API routes under src/app/api.

# --- Stellar / Soroban (testnet defaults are used when unset) ---
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org

# Contract admin: mints demo tokens (capped), writes scores, opens credit lines.
SOROBAN_SECRET_KEY=
# Pays network fees for user-signed transactions. Must hold no role in any contract.
FEE_PAYER_SECRET=

# --- Soroban contract IDs (Stellar testnet) ---
NUSD_CONTRACT_ID=CDUFIUTO6TH5VLDZ7NWIB2P4WZJ4RIMV4Q6FS44V6LSK6R3BA7U4KZUE
NBRL_CONTRACT_ID=CBDCRA6I4UAHSQWJL2O7XLXD7BHBG24SEA5DNGM56CIGJETMVIKAV3DS
CREDIT_SCORE_CONTRACT_ID=CDALW3URIC7F4NJXNMYV5IQ45F2LNCANJBT4AOWFTTIBE4TYK5JBH77J
CREDIT_LINE_CONTRACT_ID=CAOOW56V4KKK2HNTTXOCL7VXJU7GEFOJLUWCRUYMUNOSHX74TZH7RFJN
